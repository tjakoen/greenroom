{
  "permissions": {
    "allow": [
      "Bash(grep -n *)",
      "Bash(npm run *)",
      "Bash(npx playwright *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/cloud-standards.sh\""
          }
        ]
      }
    ]
  }
}
