# ============================================================================
# LOGINS — copy this file to ".env" and fill in the real usernames/passwords.
#   cp .env.example .env
# The ".env" file is PRIVATE. It is git-ignored and can never be committed.
# NEVER put real passwords in THIS file (.env.example is committed/shared).
#
# Easiest path: skip this file and add logins in the app (Settings -> Logins).
# ============================================================================
#
# Naming (most specific wins):
#   <ENV>_<ROLE>_USERNAME / <ENV>_<ROLE>_PASSWORD   per-environment login
#   <ROLE>_USERNAME       / <ROLE>_PASSWORD         shared across environments
#
#   ENV  = the environment name, uppercased, dashes -> underscores (staging -> STAGING)
#   ROLE = the name you pass to login(page, 'admin')  -> ADMIN
#
# If the same account works everywhere, set only the shared <ROLE>_ vars once.
# Only fill in the ones you actually use. Delete or add roles as needed.

# ---- shared across all environments (used when no env-specific var is set) --
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- staging ---------------------------------------------------------------
STAGING_ADMIN_USERNAME=
STAGING_ADMIN_PASSWORD=

# ---- production ------------------------------------------------------------
PRODUCTION_ADMIN_USERNAME=
PRODUCTION_ADMIN_PASSWORD=
