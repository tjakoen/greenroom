# Secrets — real logins live in .env, never commit
.env
.env.*
!.env.example

# Your real environments (seeded from config/urls.example.json on first run).
# Keeps your live URLs out of the open-source repo.
config/urls.json

# Role definitions (seeded from config/roles.example.json + your .env on first
# run). Local per checkout; holds no secrets but stays out of the shared repo.
config/roles.json

# Saved site groups (named env presets). Local per checkout; no secrets.
config/groups.json

# App-managed test metadata (group/priority/owner/notes). A committed seed ships
# the "Examples" group so a fresh clone has a populated Tests page; the app may
# add/edit entries locally on top of it.

# Internal planning notes — kept locally, not part of the open-source repo.
GRAIN-PLAN.md

# Dependencies
node_modules/

# Intentionally lockless: bun can't resolve greenroom's depth-2+ nested github
# git-dep graph (greenroom -> pantry -> 4 layers) from scratch, so a committed
# lock only goes stale/inconsistent and can't be regenerated (see package.json
# "//dependencies" note + the bread-bun-nested-git blocker). Existing checkouts
# run from node_modules/; do NOT try to regenerate a lock.
bun.lock

# Playwright output. Anchored to the repo root (leading /) so these DON'T also
# match the committed demo/ fixtures (demo/test-results, demo/runs, …).
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local run history (archived reports, stays on this machine)
/runs/

# graphify's generated code+doc graph — regenerable, host-local
graphify-out/
