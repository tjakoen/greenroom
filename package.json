{
  "name": "greenroom",
  "version": "1.0.0",
  "private": true,
  "description": "A local, no-code app for running Playwright end-to-end checks against your live web app and reviewing the results.",
  "license": "MIT",
  "scripts": {
    "postinstall": "playwright install chromium",
    "start": "node interface/server.js",
    "demo": "GREENROOM_DEMO=1 node interface/server.js",
    "menu": "bash run.sh",
    "record": "bash record.sh",
    "test": "playwright test",
    "report": "playwright show-report",
    "ui": "playwright test --ui",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@tjakoen/pantry": "github:tjakoen/pantry"
  }
}
