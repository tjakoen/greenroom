{
  "name": "greenroom",
  "version": "1.0.0",
  "private": true,
  "description": "A local, no-code app for running Playwright end-to-end checks against your live web app and reviewing the results.",
  "license": "MIT",
  "scripts": {
    "postinstall": "playwright install chromium",
    "start": "bun interface/server.js",
    "demo": "GREENROOM_DEMO=1 bun interface/server.js",
    "dev": "bun --hot server.ts",
    "menu": "bash run.sh",
    "record": "bash record.sh",
    "test": "playwright test",
    "test:unit": "bun test lib",
    "check": "tsc --noEmit -p tsconfig.next.json",
    "check:legacy": "tsc --noEmit",
    "report": "playwright show-report",
    "ui": "playwright test --ui",
    "codegen": "playwright codegen",
    "deps:refresh": "for p in batch grain mill proof pantry; do bun add @tjakoen/$p@github:tjakoen/$p#$(git ls-remote https://github.com/tjakoen/$p.git main | cut -c1-7); done"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "bun-types": "^1.3.14",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@tjakoen/batch": "github:tjakoen/batch#f9ecb03",
    "@tjakoen/grain": "github:tjakoen/grain#3e94bdc",
    "@tjakoen/mill": "github:tjakoen/mill#15fa3a5",
    "@tjakoen/pantry": "github:tjakoen/pantry#c629008",
    "@tjakoen/proof": "github:tjakoen/proof#f06daab"
  }
}
